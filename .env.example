# =========================================================
# Mini CDN Routing Simulator & NetPilot Copilot Configuration
# =========================================================

# --- Option 1: Groq API (Recommended - Fast & Free Tier Available) ---
# Obtain your free API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# (Base URL defaults automatically to https://api.groq.com/openai/v1)

# --- Option 2: Generic OpenAI / Other Provider ---
# Leave both GROQ_API_KEY and LLM_API_KEY blank to run offline without AI features.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Embedding Model (for M5 RAG Vector Store) ---
EMBED_MODEL=text-embedding-3-small

# --- Global Kill Switch ---
# Set to 'false' to immediately disable /api/copilot/chat with 503
# The rest of the routing simulator and dashboard remains functional.
COPILOT_ENABLED=true

# --- Guardrails & Budgets ---
# Max copilot chat requests per session per minute (returns 429)
RATE_LIMIT_PER_MINUTE=10

# Max tokens consumed per calendar day UTC across all sessions (returns 429)
DAILY_TOKEN_BUDGET=100000

# --- Flask Server Settings ---
PORT=5000
FLASK_DEBUG=false
